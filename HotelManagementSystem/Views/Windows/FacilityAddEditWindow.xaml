<Window x:Class="HotelManagementSystem.Views.Windows.FacilityAddEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:HotelManagementSystem.Converters"
        Title="{Binding WindowTitle}" Height="245" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style TargetType="TextBox">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <StackPanel>
                            <AdornedElementPlaceholder/>
                            <TextBlock Foreground="Red" FontSize="12" Text="{Binding [0].ErrorContent}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="91"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- FacilityId (chỉ hiển thị khi sửa) -->
        <TextBlock Text="Mã thiết bị:" Grid.Column="0" Margin="0,0,8,25" VerticalAlignment="Center" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}" Height="16"/>
        <TextBox Text="{Binding FacilityId}" Grid.Row="0" Grid.Column="1" Margin="0,0,0,25" IsReadOnly="True" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- FacilityName -->
        <TextBlock Text="Tên thiết bị:" Grid.Row="1" Grid.Column="0" Margin="0,0,8,25" VerticalAlignment="Center" Height="16"/>
        <TextBox Text="{Binding FacilityName, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}" Grid.Row="1" Grid.Column="1" Margin="0,0,0,25" LostFocus="FacilityName_LostFocus"/>

        <!-- Description -->
        <TextBlock Text="Mô tả:" Grid.Row="2" Grid.Column="0" Margin="0,0,8,25" VerticalAlignment="Center" Height="16"/>
        <TextBox Text="{Binding Description}" Grid.Row="2" Grid.Column="1" Margin="0,0,0,25"/>

        <!-- Nút Lưu và Hủy -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5,0,5" Grid.Column="1" Width="168">
            <Button Content="Lưu" Width="80" Margin="0,0,8,0" Command="{Binding SaveCommand}" Height="23"/>
            <Button Content="Hủy" Width="80" Command="{Binding CancelCommand}" Height="22"/>
        </StackPanel>
    </Grid>
</Window> 