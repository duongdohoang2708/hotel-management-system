<Window x:Class="HotelManagementSystem.Views.Windows.FacilityAddEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:HotelManagementSystem.Converters"
        Title="{Binding WindowTitle}" Height="199" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- FacilityId (chỉ hiển thị khi sửa) -->
        <TextBlock Text="Mã thiết bị:" Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <TextBox Text="{Binding FacilityId}" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" IsReadOnly="True" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- FacilityName -->
        <TextBlock Text="Tên thiết bị:" Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center"/>
        <TextBox Text="{Binding FacilityName}" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>

        <!-- Description -->
        <TextBlock Text="Mô tả:" Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center"/>
        <TextBox Text="{Binding Description}" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>

        <!-- Nút Lưu và Hủy -->
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="96,16,0,0">
            <Button Content="Lưu" Width="80" Margin="0,0,8,0" Command="{Binding SaveCommand}" Height="23"/>
            <Button Content="Hủy" Width="80" Command="{Binding CancelCommand}" Height="22"/>
        </StackPanel>
    </Grid>
</Window> 