<Window x:Class="HotelManagementSystem.Views.Windows.BookingAddEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:HotelManagementSystem.Converters"
        Title="Sửa đặt phòng" Height="425" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringNotNullOrWhiteSpaceToVisibilityConverter x:Key="StringNotNullOrWhiteSpaceToVisibilityConverter"/>
        <converters:VnCurrencyConverter x:Key="VnCurrencyConverter"/>
        <Style TargetType="TextBox">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <StackPanel>
                            <AdornedElementPlaceholder/>
                            <TextBlock Foreground="Red" FontSize="12" Text="{Binding [0].ErrorContent}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <StackPanel>
                            <AdornedElementPlaceholder/>
                            <TextBlock Foreground="Red" FontSize="12" Text="{Binding [0].ErrorContent}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="104"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- BookingId (chỉ hiển thị khi sửa) -->
        <TextBlock Text="Mã đặt phòng:" Grid.Column="0" Margin="0,5,8,0" VerticalAlignment="top"
                   Visibility="Visible" Height="16"/>
        <TextBox Text="{Binding Booking.BookingId}" Grid.Row="0" Grid.Column="1" Margin="0,0,0,25"
                 IsReadOnly="True" Visibility="Visible" Height="25"/>

        <!-- Guest -->
        <TextBlock Text="Khách hàng:" Grid.Row="1" Grid.Column="0" Margin="0,5,8,0" VerticalAlignment="Top" Height="16"/>
        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,25" Height="25"
                  ItemsSource="{Binding Guests}"
                  DisplayMemberPath="FullName"
                  SelectedItem="{Binding Booking.Guest, Mode=TwoWay, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"/>

        <!-- CheckIn -->
        <TextBlock Text="Ngày nhận:" Grid.Row="2" Grid.Column="0" Margin="0,5,8,0" Height="16" VerticalAlignment="top" />
        <DatePicker Grid.Row="2" Grid.Column="1" Margin="0,0,0,25" Height="25" SelectedDate="{Binding Booking.CheckIn, Mode=TwoWay}"/>

        <!-- CheckOut -->
        <TextBlock Text="Ngày trả:" Grid.Row="3" Grid.Column="0" Margin="0,5,8,0" Height="16" VerticalAlignment="top" />
        <DatePicker Grid.Row="3" Grid.Column="1" Margin="0,0,0,25" Height="25" SelectedDate="{Binding Booking.CheckOut, Mode=TwoWay}"/>

        <!-- Deposit -->
        <TextBlock Text="Tiền cọc:" Grid.Row="4" Grid.Column="0" Margin="0,5,8,0" Height="16" VerticalAlignment="top" />
        <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,25" Height="25" Orientation="Vertical">
            <TextBox Text="{Binding Booking.Deposit, Mode=TwoWay, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}" Height="25"/>
            <TextBlock Text="{Binding Booking.Deposit, Converter={StaticResource VnCurrencyConverter}}" Foreground="Gray" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Status -->
        <TextBlock Text="Trạng thái:" Grid.Row="5" Grid.Column="0" Margin="0,5,8,0" Height="16" VerticalAlignment="top" />
        <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Height="25" VerticalAlignment="top"
                  ItemsSource="{Binding Statuses}"
                  DisplayMemberPath="StatusName"
                  SelectedItem="{Binding Booking.Status, Mode=TwoWay, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"/>

        <!-- Nút Lưu và Hủy -->
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,50,0,0" Width="184">
            <Button Content="Lưu" Width="80" Margin="0,0,25,0" Command="{Binding SaveCommand}" Style="{StaticResource ButtonBlueSmall}"/>
            <Button Content="Hủy" Width="80" Command="{Binding CancelCommand}"  Style="{StaticResource ButtonPurpleSmall}"/>
        </StackPanel>
    </Grid>
</Window> 