<Window x:Class="HotelManagementSystem.Views.Windows.ServiceAddEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:HotelManagementSystem.Converters"
        Title="{Binding WindowTitle}" Height="300" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="20,20,20,3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ServiceId (chỉ hiển thị khi sửa) -->
        <TextBlock Text="Mã dịch vụ:" Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <TextBox Text="{Binding ServiceId}" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" IsReadOnly="True" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}" Height="25"/>

        <!-- ServiceName -->
        <TextBlock Text="Tên dịch vụ:" Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center"/>
        <TextBox Text="{Binding ServiceName}" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Height="25"/>

        <!-- UnitPrice -->
        <TextBlock Text="Đơn giá:" Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center"/>
        <TextBox Text="{Binding UnitPrice}" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Height="25"/>

        <!-- CategoryId -->
        <TextBlock Text="Loại dịch vụ:" Grid.Row="3" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                  ItemsSource="{Binding ServiceCategories}"
                  SelectedItem="{Binding SelectedCategory}"
                  DisplayMemberPath="CategoryName"
                  SelectedValuePath="CategoryId" Height="25"/>

        <!-- Nút Lưu và Hủy -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="106,24,0,24">
            <Button Content="Lưu" Width="80" Margin="0,0,8,0" Command="{Binding SaveCommand}" Height="23"/>
            <Button Content="Hủy" Width="80" Command="{Binding CancelCommand}" Height="22"/>
        </StackPanel>
    </Grid>
</Window> 