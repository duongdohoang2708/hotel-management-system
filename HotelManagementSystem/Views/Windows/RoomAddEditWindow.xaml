<Window x:Class="HotelManagementSystem.Views.Windows.RoomAddEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:HotelManagementSystem.Converters"
        Title="{Binding WindowTitle}" Height="400" Width="450" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="20,20,20,3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- RoomId (chỉ hiển thị khi sửa) -->
        <TextBlock Text="Mã phòng:" Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <TextBox Text="{Binding RoomId}" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" IsReadOnly="True" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}" Height="25"/>

        <!-- RoomNumber -->
        <TextBlock Text="Số phòng:" Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center"/>
        <TextBox Text="{Binding RoomNumber}" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Height="25"/>

        <!-- RoomType -->
        <TextBlock Text="Loại phòng:" Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                  ItemsSource="{Binding RoomTypes}"
                  SelectedItem="{Binding SelectedRoomType}"
                  DisplayMemberPath="TypeName"
                  SelectedValuePath="RoomTypeId" Height="25"/>

        <!-- Status -->
        <TextBlock Text="Trạng thái:" Grid.Row="3" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                  ItemsSource="{Binding StatusOptions}"
                  SelectedItem="{Binding Status}" Height="25"/>

        <!-- CleanStatus -->
        <TextBlock Text="Tình trạng dọn dẹp:" Grid.Row="4" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"
                  ItemsSource="{Binding CleanStatusOptions}"
                  SelectedItem="{Binding CleanStatus}" Height="25"/>

        <!-- Nút Lưu và Hủy -->
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="106,24,0,24">
            <Button Content="Lưu" Width="80" Margin="0,0,8,0" Command="{Binding SaveCommand}" Height="23"/>
            <Button Content="Hủy" Width="80" Command="{Binding CancelCommand}" Height="22"/>
        </StackPanel>
    </Grid>
</Window> 