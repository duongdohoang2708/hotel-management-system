<Window x:Class="HotelManagementSystem.Views.Windows.GuestAddEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:HotelManagementSystem.Converters"
        Title="{Binding WindowTitle}" Height="335" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style TargetType="TextBox">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <StackPanel>
                            <AdornedElementPlaceholder/>
                            <TextBlock Foreground="Red" FontSize="12" Text="{Binding [0].ErrorContent}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20,20,20,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="104"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- GuestId (chỉ hiển thị khi sửa) -->

        <!-- FullName -->
        <TextBlock Text="Họ và tên:" Grid.Column="0" Margin="0,5,0,0" Height="25" VerticalAlignment="Top"/>
        <TextBox Text="{Binding FullName, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}" Grid.Column="1" Margin="0,2,0,22" LostFocus="FullName_LostFocus"/>

        <!-- Address -->
        <TextBlock Text="Địa chỉ:" Grid.Row="1" Grid.Column="0" Margin="0,5,0,0" VerticalAlignment="Top" Height="25"/>
        <TextBox Text="{Binding Address, UpdateSourceTrigger=LostFocus}" Grid.Row="1" Grid.Column="1" Margin="0,2,0,22" Height="25"/>

        <!-- Phone -->
        <TextBlock Text="Số điện thoại:" Grid.Row="2" Grid.Column="0" Margin="0,5,0,0" VerticalAlignment="top" Height="25"/>
        <TextBox Text="{Binding Phone, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}" 
                 Height="25" Grid.Row="2" Grid.Column="1" Margin="0,2,0,22" LostFocus="Phone_LostFocus"/>

        <!-- IdCardNo -->
        <TextBlock Text="CMND/CCCD:" Grid.Row="3" Grid.Column="0" Margin="0,5,0,0" VerticalAlignment="Top" Height="25"/>
        <TextBox Text="{Binding IdCardNo, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}" 
                 Height="25" Grid.Row="3" Grid.Column="1" Margin="0,2,0,22" LostFocus="IdCardNo_LostFocus"/>

        <!-- Nút Lưu và Hủy -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="13,24,0,24" Grid.Column="1" Width="180">
            <Button Content="Lưu" Width="80" Margin="0,0,20,0" Command="{Binding SaveCommand}" Style="{StaticResource ButtonBlueSmall}"/>
            <Button Content="Hủy" Width="80" Command="{Binding CancelCommand}" Style="{StaticResource ButtonPurpleSmall}"/>
        </StackPanel>
    </Grid>
</Window> 