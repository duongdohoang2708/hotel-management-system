<Window x:Class="HotelManagementSystem.Views.Windows.StaffAddEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:HotelManagementSystem.Converters"
        Title="{Binding WindowTitle}" Height="412" Width="370" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringNotNullOrWhiteSpaceToVisibilityConverter x:Key="StringNotNullOrWhiteSpaceToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="20,5,20,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- StaffId (chỉ hiển thị khi sửa) -->
        <TextBlock Text="Mã nhân viên:" Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" 
                   Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <TextBox Text="{Binding StaffId}" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" IsReadOnly="True" 
                 Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}" Height="25"/>

        <!-- FullName -->
        
        <TextBlock Text="Họ và tên:" Grid.Row="1" Grid.Column="0" Margin="0,17,8,8" VerticalAlignment="Center"/>
        <TextBox Text="{Binding FullName}" Grid.Row="1" Grid.Column="1" Margin="0,17,0,8" Height="25"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,55,0,0" Foreground="Red" FontSize="10"
                   Text="{Binding FullNameError}"
                   Visibility="{Binding FullNameError, Converter={StaticResource StringNotNullOrWhiteSpaceToVisibilityConverter}}"/>

        <!-- Email -->
        <TextBlock Text="Email:" Grid.Row="2" Grid.Column="0" Margin="0,17,8,8" VerticalAlignment="Center"/>
        <TextBox Text="{Binding Email}" Grid.Row="2" Grid.Column="1" Margin="0,17,0,8" Height="25"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,55,0,0" Foreground="Red" FontSize="10"
                   Text="{Binding EmailError}"
                   Visibility="{Binding EmailError, Converter={StaticResource StringNotNullOrWhiteSpaceToVisibilityConverter}}"/>

        <!-- Phone -->
        <TextBlock Text="Số điện thoại:" Grid.Row="3" Grid.Column="0" Margin="0,17,8,8" VerticalAlignment="Center"/>
        <TextBox Text="{Binding Phone}" Grid.Row="3" Grid.Column="1" Margin="0,17,0,8" Height="25"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,55,0,0" Foreground="Red" FontSize="10"
                   Text="{Binding PhoneError}"
                   Visibility="{Binding PhoneError, Converter={StaticResource StringNotNullOrWhiteSpaceToVisibilityConverter}}"/>

        <!-- Position -->
        <TextBlock Text="Vị trí công việc:" Grid.Row="4" Grid.Column="0" Margin="0,17,8,8" VerticalAlignment="Center"/>
        <TextBox Text="{Binding Position}" Grid.Row="4" Grid.Column="1" Margin="0,17,0,8" Height="25"/>

        <!-- Nút Lưu và Hủy -->
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,17,0,17">
            <Button Content="Lưu" Width="80" Margin="0,0,20,0" Command="{Binding SaveCommand}" Style="{StaticResource ButtonBlueSmall}"/>
            <Button Content="Hủy" Width="80" Command="{Binding CancelCommand}" Style="{StaticResource ButtonPurpleSmall}"/>
        </StackPanel>
    </Grid>
</Window> 