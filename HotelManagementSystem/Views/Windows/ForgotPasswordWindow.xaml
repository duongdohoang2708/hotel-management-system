<Window x:Class="HotelManagementSystem.Views.Windows.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quên mật khẩu" Height="520" Width="420" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#f4f6fb">
    <Grid>
        <Border CornerRadius="16" Background="White" Padding="32" Margin="40">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="12" Color="#888"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" >
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <TextBlock Text="Quên mật khẩu" FontWeight="Bold" FontSize="20" Foreground="#2d3a4a" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Tên đăng nhập" FontWeight="SemiBold" FontSize="14" Foreground="#4F8EF7" Margin="0,0,0,2"/>
                <TextBox Height="32" Width="240" Margin="0,0,0,12" FontSize="15" Padding="5,4" 
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Mật khẩu mới" FontWeight="SemiBold" FontSize="14" Foreground="#4F8EF7" Margin="0,0,0,2"/>
                <PasswordBox Height="32" Width="240" Margin="0,0,0,12" FontSize="15" Padding="5,4" x:Name="NewPasswordBox"/>
                <TextBlock Text="Xác nhận mật khẩu" FontWeight="SemiBold" FontSize="14" Foreground="#4F8EF7" Margin="0,0,0,2"/>
                <PasswordBox Height="32" Width="240" Margin="0,0,0,12" FontSize="15" Padding="5,4" x:Name="ConfirmPasswordBox"/>
                <Button Content="Xác nhận" Width="240" Height="36" Margin="0,8,0,0" FontSize="16" FontWeight="Bold"
                        Background="#4F8EF7" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Command="{Binding ConfirmCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#4F8EF7"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2566d8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#174a96"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#e74c3c" FontWeight="Bold" FontSize="13" Margin="0,12,0,0" TextAlignment="Center"/>
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#27ae60" FontWeight="Bold" FontSize="13" Margin="0,4,0,0" TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window> 