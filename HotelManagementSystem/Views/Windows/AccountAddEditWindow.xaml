<Window x:Class="HotelManagementSystem.Views.Windows.AccountAddEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:HotelManagementSystem.Converters"
        Title="{Binding WindowTitle}" Height="370" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style TargetType="TextBox">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <StackPanel>
                            <AdornedElementPlaceholder/>
                            <TextBlock Foreground="Red" FontSize="12" Text="{Binding [0].ErrorContent}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <Binding RelativeSource="{RelativeSource Self}" Path="DataContext"/>
    </Window.DataContext>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- AccountID (chỉ hiển thị khi sửa) -->
        <TextBlock Text="Mã tài khoản:" Grid.Row="0" Grid.Column="0" Margin="0,0,8,25" VerticalAlignment="Center" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <TextBox Text="{Binding AccountID}" Grid.Row="0" Grid.Column="1" Margin="0,0,0,25" IsReadOnly="True" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}" Height="26"/>

        <!-- Username -->
        <TextBlock Text="Tên đăng nhập:" Grid.Row="1" Grid.Column="0" Margin="0,0,8,25" VerticalAlignment="Center"/>
        <TextBox Text="{Binding Username, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}" Grid.Row="1" Grid.Column="1" Margin="0,0,0,25" LostFocus="Username_LostFocus" Height="26"/>

        <!-- Password -->
        <TextBlock Text="Mật khẩu:" Grid.Row="2" Grid.Column="0" Margin="0,0,8,25" VerticalAlignment="Center"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,25" PasswordChanged="PasswordBox_PasswordChanged" LostFocus="PasswordBox_LostFocus"/>

        <!-- Role -->
        <TextBlock Text="Vai trò:" Grid.Row="3" Grid.Column="0" Margin="0,0,8,25" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,25"
                  ItemsSource="{Binding Roles}"
                  SelectedItem="{Binding Role, Mode=TwoWay}"/>

        <!-- Staff (chỉ cho chọn khi thêm) -->
        <TextBlock Text="Nhân viên:" Grid.Row="4" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"
                  ItemsSource="{Binding StaffList}"
                  DisplayMemberPath="FullName"
                  SelectedValuePath="StaffId"
                  SelectedValue="{Binding StaffId, Mode=TwoWay}"
                  IsEnabled="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"/>

        <!-- Nút Lưu và Hủy -->
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Content="Lưu" Width="80" Margin="0,0,8,0" Command="{Binding SaveCommand}" Height="23"/>
            <Button Content="Hủy" Width="80" Command="{Binding CancelCommand}" Height="22"/>
        </StackPanel>
    </Grid>
</Window> 