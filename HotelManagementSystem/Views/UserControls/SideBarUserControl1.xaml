<UserControl x:Class="HotelManagementSystem.Views.UserControls.SideBarUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Height="Auto" Width="280">
    <Grid Background="#2C3E50">
        <StackPanel Margin="10" VerticalAlignment="Top">

            <!-- QUY TRÌNH PHỤC VỤ -->
            <TextBlock Text="NGHIỆP VỤ" Foreground="#FF04F9B9" Margin="10,0,0,10" FontWeight="Bold" FontSize="14"/>

            <Button Style="{StaticResource SideBarButtonStyle}" Command="{Binding NavigateBookingCommand}" HorizontalAlignment="Left" Width="260" Background="#FF1A3F5D" Height="50">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="PhoneIncoming" Width="20" Margin="0,0,8,0" Foreground="White"/>
                    <TextBlock Text="Đặt phòng" Foreground="White"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource SideBarButtonStyle}" Command="{Binding NavigateCheckInCommand}" Margin="0,10,0,0" Height="50" Background="#FF1A3F5D">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="CheckboxMarked" Width="20" Margin="0,0,8,0" Foreground="White"/>
                    <TextBlock Text="Nhận phòng" Foreground="White"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource SideBarButtonStyle}" Command="{Binding NavigateCheckOutCommand}" Margin="0,10,0,0" Height="50" Background="#FF1A3F5D">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="LogoutVariant" Width="20" Margin="0,0,8,0" Foreground="White"/>
                    <TextBlock Text="Trả phòng" Foreground="White"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource SideBarButtonStyle}" Command="{Binding NavigateServiceUsageCommand}" Margin="0,10,0,0" Height="50" Background="#FF1A3F5D">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="RoomServiceOutline" Width="20" Margin="0,0,8,0" Foreground="White"/>
                    <TextBlock Text="Dịch vụ" Foreground="White"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource SideBarButtonStyle}" Command="{Binding NavigateReportCommand}" Margin="0,10,0,0" Height="50" Background="#FF1A3F5D">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ChartBar" Width="20" Margin="0,0,8,0" Foreground="White"/>
                    <TextBlock Text="Báo cáo" Foreground="White"/>
                </StackPanel>
            </Button>

            <!-- QUẢN TRỊ HỆ THỐNG -->
            <TextBlock Text="HỆ THỐNG" Foreground="#FF04F9B9" Margin="10,20,0,10" FontWeight="Bold" FontSize="14"/>

            <Button Style="{StaticResource SideBarButtonStyle}" Command="{Binding NavigateGuestCommand}" Background="#FF37352F" Height="50">
                <StackPanel Orientation="Horizontal" >
                    <iconPacks:PackIconMaterial Kind="AccountMultipleOutline" Width="20" Margin="0,0,8,0" Foreground="White"/>
                    <TextBlock Text="Khách hàng" Foreground="White"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource SideBarButtonStyle}" Command="{Binding NavigateRoomCommand}" Margin="0,10,0,0" Background="#FF37352F" Height="50">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" >
                    <iconPacks:PackIconMaterial Kind="BedOutline" Width="20" Margin="0,0,8,0" Foreground="White"/>
                    <TextBlock Text="Phòng" Foreground="White"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource SideBarButtonStyle}" Command="{Binding NavigateServiceCommand}" Background="#FF37352F" Height="50" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="CartOutline" Width="20" Margin="0,0,8,0" Foreground="White"/>
                    <TextBlock Text="Dịch vụ" Foreground="White"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource SideBarButtonStyle}" Command="{Binding NavigateStaffCommand}" Height="50" Background="#FF37352F" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="AccountTieOutline" Width="20" Margin="0,0,8,0" Foreground="White"/>
                    <TextBlock Text="Nhân sự" Foreground="White"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SideBarButtonStyle}" Command="{Binding NavigateStaffCommand}" Margin="0,10,0,0" Background="#FF37352F" Height="50">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="AccountTieOutline" Width="20" Margin="0,0,8,0" Foreground="White"/>
                    <TextBlock Text="Tài khoản người dùng" Foreground="White"/>
                </StackPanel>
            </Button>

        </StackPanel>
    </Grid>
</UserControl>
