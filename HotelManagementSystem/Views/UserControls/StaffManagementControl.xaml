<UserControl x:Class="HotelManagementSystem.Views.UserControls.StaffManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,10" VerticalAlignment="Center">
            <TextBox Width="300" Margin="0,0,10,0"
                     materialDesign:HintAssist.Hint="Nhập tên, SĐT hoặc chức vụ nhân viên"
                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Thêm nhân viên" Width="180" Command="{Binding AddCommand}" Background="#4CAF50" Foreground="White"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding FilteredStaffList}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã NV" Binding="{Binding StaffId}" Width="70"/>
                <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="160"/>
                <DataGridTextColumn Header="Chức vụ" Binding="{Binding Position}" Width="100"/>
                <DataGridTextColumn Header="SĐT" Binding="{Binding Phone}" Width="100"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="140"/>
                <DataGridTextColumn Header="Giới tính" Binding="{Binding GenderDisplay}" Width="80"/>
                <DataGridTextColumn Header="Ngày sinh" Binding="{Binding DateOfBirthDisplay}" Width="100"/>
                <DataGridTextColumn Header="Địa chỉ" Binding="{Binding Address}" Width="140"/>
                <DataGridTextColumn Header="Lương" Binding="{Binding Salary}" Width="100"/>
                <DataGridTemplateColumn Header="Sửa" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.EditStaffCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="✏️"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Xóa" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="❌"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl> 