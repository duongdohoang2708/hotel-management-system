<UserControl x:Class="HotelManagementSystem.Views.UserControls.AmenityManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,10" VerticalAlignment="Center">
            <TextBox Width="300" Margin="0,0,10,0"
                     materialDesign:HintAssist.Hint="Nhập tên tiện nghi"
                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Thêm tiện nghi" Width="180" Command="{Binding AddCommand}" Background="#4CAF50" Foreground="White"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding FilteredAmenityList}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã tiện nghi" Binding="{Binding AmenityId}" Width="80"/>
                <DataGridTextColumn Header="Tên tiện nghi" Binding="{Binding AmenityName}" Width="180"/>
                <DataGridTextColumn Header="Mô tả" Binding="{Binding Description}" Width="220"/>
                <DataGridTemplateColumn Header="Sửa" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="✏️"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl> 