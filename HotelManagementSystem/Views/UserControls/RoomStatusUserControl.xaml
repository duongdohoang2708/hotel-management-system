<UserControl x:Class="HotelManagementSystem.Views.UserControls.RoomStatusUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:HotelManagementSystem.Views.UserControls"
             xmlns:vm="clr-namespace:HotelManagementSystem.ViewModels"
             Height="Auto" Width="Auto">
    <Grid Background="#F8F9FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Filter Panel -->
        <Border Grid.Column="0" Background="#FFF" Padding="18" CornerRadius="16" Margin="16,24,8,16">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="0" Opacity="0.12"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <!-- Ngày giờ và tìm kiếm -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20" HorizontalAlignment="Center">
                    <DatePicker Width="180"/>
                </StackPanel>
                <TextBox Width="200" Height="32" Margin="0,0,0,24" materialDesign:HintAssist.Hint="Tìm phòng"/>
                <!-- Trạng thái -->
                <TextBlock Text="Trạng thái" FontWeight="Bold" Foreground="#1976D2" FontSize="16" Margin="0,0,0,8"/>
                <StackPanel Margin="0,0,0,20">
                    <RadioButton Content="Phòng trống" GroupName="Status" Margin="0,2"/>
                    <RadioButton Content="Phòng đã đặt" GroupName="Status" Margin="0,2"/>
                    <RadioButton Content="Phòng đang thuê" GroupName="Status" Margin="0,2"/>
                    <RadioButton Content="Tất cả phòng" GroupName="Status" Margin="0,2" IsChecked="True"/>
                </StackPanel>
                <!-- Loại phòng -->
                <TextBlock Text="Loại phòng" FontWeight="Bold" Foreground="#1976D2" FontSize="16" Margin="0,0,0,8"/>
                <StackPanel Margin="0,0,0,20">
                    <RadioButton Content="Phòng đơn" GroupName="Type" Margin="0,2"/>
                    <RadioButton Content="Phòng đôi" GroupName="Type" Margin="0,2"/>
                    <RadioButton Content="Phòng gia đình" GroupName="Type" Margin="0,2"/>
                    <RadioButton Content="Tất cả loại phòng" GroupName="Type" Margin="0,2" IsChecked="True"/>
                </StackPanel>
                <!-- Dọn dẹp -->
                <TextBlock Text="Dọn dẹp" FontWeight="Bold" Foreground="#1976D2" FontSize="16" Margin="0,0,0,8"/>
                <StackPanel>
                    <RadioButton Content="Đã dọn dẹp" GroupName="Clean" Margin="0,2"/>
                    <RadioButton Content="Chưa dọn dẹp" GroupName="Clean" Margin="0,2"/>
                    <RadioButton Content="Sửa chữa" GroupName="Clean" Margin="0,2"/>
                    <RadioButton Content="Tất cả" GroupName="Clean" Margin="0,2" IsChecked="True"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <!-- Room Cards Panel -->
        <Border Grid.Column="1" Background="#FFF" CornerRadius="16" Padding="24" Margin="0,24,24,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Phòng đơn -->
                    <TextBlock Text="Phòng đơn" FontWeight="Bold" FontSize="20" Foreground="#1976D2" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding SingleRooms}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" Margin="0,0,0,0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="240" Height="110" Margin="10" CornerRadius="14" 
                                        Background="{Binding CardBackground}" 
                                        BorderBrush="#E0E0E0" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="32"/>
                                        </Grid.RowDefinitions>
                                        <!-- Thông tin chính -->
                                        <StackPanel Orientation="Horizontal" Margin="12,8,12,0">
                                            <materialDesign:PackIcon Kind="Account" Width="28" Height="28" Margin="0,0,8,0" Foreground="#757575"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding RoomName}" FontWeight="Bold" FontSize="16"/>
                                                <TextBlock Text="{Binding CustomerName}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#388E3C"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- Thông tin phụ -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,8" VerticalAlignment="Bottom">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <materialDesign:PackIcon Kind="Calendar" Width="18" Height="18" Foreground="#757575" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding StayDuration}" FontSize="13"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Foreground="#388E3C" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding CleanStatus}" FontSize="13"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Phòng đôi -->
                    <TextBlock Text="Phòng đôi" FontWeight="Bold" FontSize="20" Foreground="#1976D2" Margin="0,24,0,12"/>
                    <ItemsControl ItemsSource="{Binding DoubleRooms}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" Margin="0,0,0,0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="240" Height="110" Margin="10" CornerRadius="14" 
                                        Background="{Binding CardBackground}" 
                                        BorderBrush="#E0E0E0" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="32"/>
                                        </Grid.RowDefinitions>
                                        <!-- Thông tin chính -->
                                        <StackPanel Orientation="Horizontal" Margin="12,8,12,0">
                                            <materialDesign:PackIcon Kind="AccountGroup" Width="28" Height="28" Margin="0,0,8,0" Foreground="#757575"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding RoomName}" FontWeight="Bold" FontSize="16"/>
                                                <TextBlock Text="{Binding CustomerName}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#388E3C"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- Thông tin phụ -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,8" VerticalAlignment="Bottom">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <materialDesign:PackIcon Kind="Calendar" Width="18" Height="18" Foreground="#757575" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding StayDuration}" FontSize="13"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Foreground="#388E3C" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding CleanStatus}" FontSize="13"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Phòng gia đình -->
                    <TextBlock Text="Phòng gia đình" FontWeight="Bold" FontSize="20" Foreground="#1976D2" Margin="0,24,0,12"/>
                    <ItemsControl ItemsSource="{Binding FamilyRooms}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" Margin="0,0,0,0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="240" Height="110" Margin="10" CornerRadius="14" 
                                        Background="{Binding CardBackground}" 
                                        BorderBrush="#E0E0E0" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="32"/>
                                        </Grid.RowDefinitions>
                                        <!-- Thông tin chính -->
                                        <StackPanel Orientation="Horizontal" Margin="12,8,12,0">
                                            <materialDesign:PackIcon Kind="HomeGroup" Width="28" Height="28" Margin="0,0,8,0" Foreground="#757575"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding RoomName}" FontWeight="Bold" FontSize="16"/>
                                                <TextBlock Text="{Binding CustomerName}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#388E3C"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- Thông tin phụ -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,8" VerticalAlignment="Bottom">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <materialDesign:PackIcon Kind="Calendar" Width="18" Height="18" Foreground="#757575" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding StayDuration}" FontSize="13"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Foreground="#388E3C" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding CleanStatus}" FontSize="13"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl> 