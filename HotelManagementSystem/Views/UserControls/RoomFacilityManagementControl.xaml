<UserControl x:Class="HotelManagementSystem.Views.UserControls.RoomFacilityManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,10" VerticalAlignment="Center">
            <TextBox Width="300" Margin="0,0,10,0"
                     materialDesign:HintAssist.Hint="Nhập tên tiện nghi hoặc số phòng"
                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Thêm chi tiết tiện nghi" Width="180" Command="{Binding AddCommand}" Background="#4CAF50" Foreground="White"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding FilteredRoomFacilityList}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Số phòng" Binding="{Binding Room.RoomNumber}" Width="100"/>
                <DataGridTextColumn Header="Tên tiện ích" Binding="{Binding Facility.FacilityName}" Width="180"/>
                <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="100"/>
                <DataGridTemplateColumn Header="Sửa" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="✏️"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Xóa" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="❌"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl> 