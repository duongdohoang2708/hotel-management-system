<UserControl x:Class="HotelManagementSystem.Views.UserControls.RoomManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,10" VerticalAlignment="Center">
            <TextBox Width="300" Margin="0,0,10,0"
                     materialDesign:HintAssist.Hint="Nhập thông tin phòng (số phòng, trạng thái,...)"
                     Text="{Binding SearchRoomNumber, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Thêm phòng" Width="180" Command="{Binding AddCommand}" Background="#4CAF50" Foreground="White"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding FilteredRoomList}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Số phòng" Binding="{Binding RoomNumber}" Width="90"/>
                <DataGridTextColumn Header="Tình trạng" Binding="{Binding Status}" Width="160"/>
                <DataGridTextColumn Header="Tình trạng dọn dẹp" Binding="{Binding CleanStatus}" Width="230"/>
                <DataGridTextColumn Header="Loại phòng" Binding="{Binding RoomType.TypeName}" Width="130"/>
                <DataGridTextColumn Header="Tầng" Binding="{Binding Floor}" Width="80"/>
                <DataGridTemplateColumn Header="Sửa" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="✏️"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Xóa" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="❌"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl> 