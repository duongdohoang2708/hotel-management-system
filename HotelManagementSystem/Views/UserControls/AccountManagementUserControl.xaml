<UserControl x:Class="HotelManagementSystem.Views.UserControls.AccountManagementUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HotelManagementSystem.Views.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Nút thêm -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Nút Thêm nằm ở bên trái -->
        <Button Content="➕ Thêm tài khoản" Width="160" HorizontalAlignment="Left" Margin="0,0,0,10"
                Grid.Row="0" Grid.Column="0" Command="{Binding AddAccountCommand}" 
                Style="{StaticResource ButtonLarge}" />

        <!-- Khung tìm kiếm nằm ở bên phải -->
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
            <TextBox Width="200" Margin="0,0,5,0" Style="{StaticResource TextboxStyle}"
                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}">
                
                <TextBox.ToolTip>
                    <ToolTip Content="Tìm kiếm theo tên đăng nhập, vai trò, họ tên hoặc vị trí công việc"/>
                </TextBox.ToolTip>
            </TextBox>
            <Button Content="🔍 Tìm kiếm" Width="80"  Margin="0,0,5,0"
                    Command="{Binding SearchCommand}"
                    Style="{StaticResource ButtonBlueSmall}" >
            </Button>
            <Button Content="❌ Xóa" Width="60" Height="25" 
                    Command="{Binding ClearSearchCommand}"
                    Style="{StaticResource ButtonPurpleSmall}" >
                
            </Button>
        </StackPanel>

        <!-- DataGrid với các nút biểu tượng -->
        <DataGrid x:Name="AccountsDataGrid" Grid.Row="1" Grid.ColumnSpan="2" AutoGenerateColumns="False"
                  CanUserAddRows="False" SelectionMode="Single"
                  ItemsSource="{Binding AccountList}"
                  IsReadOnly="True"
                  SelectedItem="{Binding SelectedAccount, Mode=TwoWay}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFFDE9B3"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Định danh" Binding="{Binding AccountID}" Width="Auto" />
                <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding Username}" Width="Auto" />
                <DataGridTextColumn Header="Mật khẩu" Binding="{Binding Password}" Width="Auto" />
                <DataGridTextColumn Header="Vai trò" Binding="{Binding Role}" Width="Auto" />
                <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="Auto" />
                

                <!-- Cột nút Sửa -->
                <DataGridTemplateColumn Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button ToolTip="Sửa"
                                    Command="{Binding DataContext.EditAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Width="32" Height="32">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="✏️" FontSize="13"/>
                                </StackPanel>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="Blue"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="ToolTip" Value="Sửa"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FFD700"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Cột nút Xóa -->
                <DataGridTemplateColumn Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button ToolTip="Xóa"
                                    Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Width="32" Height="32">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="🗑" FontSize="13"/>
                                </StackPanel>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="Red"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="ToolTip" Value="Xóa"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF1744"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>