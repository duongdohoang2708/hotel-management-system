<Window x:Class="HotelManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelManagementSystem"
        xmlns:converters="clr-namespace:HotelManagementSystem.Converters"
        xmlns:views="clr-namespace:HotelManagementSystem.Views.UserControls"
        mc:Ignorable="d"
        Title="Quản lý khách sạn" Height="800" Width="1200">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <!-- Layout chính -->
        <Grid Panel.ZIndex="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="270"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <views:UcSideBar x:Name="Sidebar"
                                      Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                                      HorizontalAlignment="Center"/>
            <!--Effect="{x:Null}" Width="270" Template="{DynamicResource PopupContentClassicTemplate}"/> -->

            <!-- Main Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="66*"/>
                    <RowDefinition Height="67*"/>
                </Grid.RowDefinitions>
                <!-- Topbar -->
                <DockPanel Grid.Row="0" Background="#FF2C3E50" Opacity="0.95" LastChildFill="True" Height="60">
                    <Button Content="☰" Width="50" Height="50" Margin="5,5,0,5" Click="HamburgerButton_Click" DockPanel.Dock="Left"
                            Style="{x:Null}" FontSize="22" Background="#FF374859" BorderThickness="0" Foreground="#FFF5EEEE"/>
                    <TextBlock Text="DD Luxury Hotel" VerticalAlignment="Center" FontSize="24" FontWeight="Bold" Margin="16,0,0,0" Foreground="#FFD5F904"/>
                </DockPanel>
                <!-- Nội dung chính động -->
                <ContentControl Grid.Row="1"
                               Content="{Binding CurrentView}" Grid.RowSpan="3"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
